+def resolve_card_id_for_health(local_rank: int) -> int:
+    """Resolve a vLLM local rank to the npu-smi NPU ID (card ID).
+
+    A local rank identifies a chip, but ``npu-smi info -i`` expects the
+    physical card. On multi-chip cards and remapped/container environments
+    these IDs differ. Resolve the bound runtime device to its chip Phy-ID and
+    map that ID to the card reported by ``npu-smi info -m``.
+    """
+    try:
+        visible_device_id = current_platform.logical_device_id_to_visible_device_id(local_rank)
+        chip_phy_id = current_platform.visible_device_id_to_physical_device_id(visible_device_id)
+        card_id = DeviceInfo.get_npu_phy_id_to_card_id().get(str(chip_phy_id))
+        if card_id is not None:
+            return int(card_id)
+    except Exception as e:
+        logger.debug("Failed to resolve npu-smi card ID for rank %s: %s", local_rank, e)
+
+    # Preserve a best-effort mapping on older hosts whose npu-smi output does
+    # not expose Chip Phy-ID. On single-chip cards the physical ID is the card.
+    try:
+        return current_platform.device_id_to_physical_device_id(local_rank)
+    except Exception:
+        return local_rank
+
