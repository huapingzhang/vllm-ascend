+from types import SimpleNamespace
+from unittest.mock import patch
+
+from tests.ut.base import TestBase
+from vllm_ascend.cpu_binding import DeviceInfo
+from vllm_ascend.worker.worker import NPUWorker, resolve_card_id_for_health
+
+WORKER_MODULE = "vllm_ascend.worker.worker"
+
+NPU_SMI_MAP = """\
+NPU ID  Chip ID  Chip Logic ID  Chip Phy-ID  Chip Name
+1  0  0  2  Ascend910
+1  1  1  3  Ascend910
+1  2  -  -  Mcu
+4  0  2  8  Ascend910
+4  1  3  9  Ascend910
+4  2  -  -  Mcu
+"""
+
+
+class TestResolveCardIdForHealth(TestBase):
+    def test_uses_phy_id_not_chip_logic_id(self):
+        with (
+            patch(f"{WORKER_MODULE}.current_platform") as platform,
+            patch.object(
+                DeviceInfo,
+                "get_npu_phy_id_to_card_id",
+                return_value={"2": "1", "3": "1", "8": "4", "9": "4"},
+            ),
+        ):
+            platform.logical_device_id_to_visible_device_id.return_value = 0
+            platform.visible_device_id_to_physical_device_id.return_value = 2
+            assert resolve_card_id_for_health(0) == 1
+
+            platform.visible_device_id_to_physical_device_id.return_value = 8
+            assert resolve_card_id_for_health(0) == 4
+
+    def test_falls_back_when_npu_smi_map_is_unavailable(self):
+        with (
+            patch(f"{WORKER_MODULE}.current_platform") as platform,
+            patch.object(DeviceInfo, "get_npu_phy_id_to_card_id", side_effect=RuntimeError("no npu-smi")),
+        ):
+            platform.logical_device_id_to_visible_device_id.return_value = 0
+            platform.visible_device_id_to_physical_device_id.return_value = 2
+            platform.device_id_to_physical_device_id.return_value = 5
+            assert resolve_card_id_for_health(0) == 5
+
+    def test_check_health_queries_mapped_card(self):
+        worker = NPUWorker.__new__(NPUWorker)
+        worker.local_rank = 0
+        completed = SimpleNamespace(
+            returncode=0,
+            stdout="Health : OK\n",
+            stderr="",
+        )
+        with (
+            patch(f"{WORKER_MODULE}.resolve_card_id_for_health", return_value=1),
+            patch("subprocess.run", return_value=completed) as run,
+        ):
+            worker.check_health()
+
+        run.assert_called_once()
+        assert run.call_args.args[0] == ["npu-smi", "info", "-i", "1", "-t", "health"]
